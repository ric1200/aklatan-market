# Uploaded pictures may be displayed, but this folder must never run code.
Options -Indexes -ExecCGI

<FilesMatch "\.(php|php3|php4|php5|php7|php8|phtml|phps|pht|phar|cgi|pl|py|rb|sh|bash|asp|aspx|jsp|shtml|htaccess|htpasswd)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Content-Disposition "inline"
</IfModule>
